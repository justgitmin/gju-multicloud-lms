generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum Role {
 STUDENT
 ADMIN
}
enum EnrollmentStatus {
 PENDING
 APPROVED
 REJECTED
}
model User {
 id String @id @default(cuid())
 email String @unique
 name String
 studentNumber String?
 passwordHash String
 role Role @default(STUDENT)
 createdAt DateTime @default(now())
 enrollments Enrollment[]
 sessions Session[]
}
model Course {
 id String @id @default(cuid())
 title String
 published Boolean @default(false)
 enrollments Enrollment[]
 lessons Lesson[]
 labs Lab[]
 quizzes Quiz[]
}
model Enrollment {
 id String @id @default(cuid())
 userId String
 courseId String
 status EnrollmentStatus @default(PENDING)
 user User @relation(fields:[userId],references:[id])
 course Course @relation(fields:[courseId],references:[id])
 progress Progress[]
 submissions Submission[]
 attempts QuizAttempt[]
 @@unique([userId,courseId])
}
model Lesson {
 id String @id @default(cuid())
 courseId String
 title String
 position Int
 videoKey String?
 durationSeconds Int
 version Int @default(1)
 course Course @relation(fields:[courseId],references:[id])
 progress Progress[]
 @@unique([courseId,position])
}
model Progress {
 id String @id @default(cuid())
 enrollmentId String
 lessonId String
 version Int
 resumeSeconds Float @default(0)
 watchedRanges Json @default("[]")
 completedAt DateTime?
 updatedAt DateTime @updatedAt
 enrollment Enrollment @relation(fields:[enrollmentId],references:[id])
 lesson Lesson @relation(fields:[lessonId],references:[id])
 @@unique([enrollmentId,lessonId,version])
}

model Session {
 id String @id @default(cuid())
 tokenHash String @unique
 userId String
 expiresAt DateTime
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([expiresAt])
}
model RateLimit {
 key String @id
 count Int @default(1)
 expiresAt DateTime
 @@index([expiresAt])
}

model Playback {
 id String @id @default(cuid())
 enrollmentId String
 lessonId String
 version Int
 lastPosition Float
 lastAt DateTime @default(now())
 revision Int @default(0)
 @@unique([enrollmentId,lessonId])
}

enum SubmissionStatus {
 PENDING
 APPROVED
 REVISION
}
model Lab {
 id String @id
 courseId String
 title String
 instructions String
 position Int
 course Course @relation(fields:[courseId],references:[id])
 submissions Submission[]
}
model Submission {
 id String @id @default(cuid())
 enrollmentId String
 labId String
 content String
 url String?
 status SubmissionStatus @default(PENDING)
 feedback String @default("")
 reviewedBy String?
 reviewedAt DateTime?
 updatedAt DateTime @updatedAt
 enrollment Enrollment @relation(fields:[enrollmentId],references:[id])
 lab Lab @relation(fields:[labId],references:[id])
 @@unique([enrollmentId,labId])
}
model Quiz {
 id String @id
 courseId String
 title String
 questions Json
 answerKey Json
 version Int @default(1)
 course Course @relation(fields:[courseId],references:[id])
 attempts QuizAttempt[]
}
model QuizAttempt {
 id String @id @default(cuid())
 enrollmentId String
 quizId String
 version Int
 score Int
 answers Json
 createdAt DateTime @default(now())
 enrollment Enrollment @relation(fields:[enrollmentId],references:[id])
 quiz Quiz @relation(fields:[quizId],references:[id])
 @@index([enrollmentId,quizId,version])
}
