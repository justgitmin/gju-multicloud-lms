# Replace locally. Never commit .env files.
POSTGRES_USER=lms
POSTGRES_PASSWORD=
POSTGRES_DB=lms
DATABASE_URL=postgresql://lms:REPLACE_ME@db:5432/lms
SITE_ADDRESS=localhost

# Enable only after privacy notice and HTTPS are finalized.
ENABLE_REGISTRATION=false

# Optional local private MP4 directory; Docker web mounts ./media read-only.
# MEDIA_ROOT=/absolute/path/media

MEDIA_BACKEND=local
MEDIA_S3_BUCKET=gju-multicloud-lms-media-2026
AWS_REGION=ap-northeast-2
# Server only. Keep actual values out of git and chat. May use temporary credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Set to the final external HTTPS origin, e.g. https://lms.example.com
APP_ORIGIN=
